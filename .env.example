# Azure Monitor / Log Analytics
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Prometheus (optional — leave blank to skip)
PROMETHEUS_ENDPOINT=http://prometheus:9090

# Grafana (optional — leave blank to skip)
GRAFANA_ENDPOINT=https://grafana.example.com
GRAFANA_API_KEY=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=owner/repo-name

# Past incidents store (path to JSON file, optional)
PAST_INCIDENTS_PATH=data/past_incidents.json

# App settings
LOG_LEVEL=INFO